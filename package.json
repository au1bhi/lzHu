{
  "name": "lzhu",
  "version": "1.0.0",
  "description": "Build tooling for Lizhong Hu's personal website.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/au1bhi/lzHu.git"
  },
  "keywords": [
    "jekyll",
    "personal-website",
    "competitive-programming"
  ],
  "author": "Lizhong Hu",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/au1bhi/lzHu/issues"
  },
  "homepage": "https://au1bhi.com",
  "engines": {
    "node": ">= 20"
  },
  "devDependencies": {
    "onchange": "^7.1.0",
    "uglify-js": "^3.17.4"
  },
  "scripts": {
    "uglify": "uglifyjs assets/js/_main.js --module -c -m -o assets/js/main.min.js",
    "watch:js": "onchange \"assets/js/_main.js\" -- npm run build:js",
    "build:js": "npm run uglify"
  }
}
