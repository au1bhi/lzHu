# Ignore the contents of the _site directory and other cache directories
_site/
.sass-cache/

# Ignore the directory for local files during development
local/

# Dependency directories (lockfiles remain tracked for reproducible builds)
node_modules

# Ignore the vendor file at root level and bundle for alternative installation
/vendor/
.bundle/

# LaTeX CV build output (the published copy under assets/pdf is tracked)
cv-latex/*.aux
cv-latex/*.fdb_latexmk
cv-latex/*.fls
cv-latex/*.log
cv-latex/*.out
cv-latex/*.pdf
cv-latex/*.synctex.gz

# Ignore folders related to IDEs
.vscode/
.claude/

# Never commit local secrets, credentials, private keys, or databases
.env
.env.*
!.env.example
credentials.json
secrets.yml
secrets.yaml
*.pem
*.key
*.p12
*.pfx
*.jks
*.keystore
*.sqlite
*.sqlite3
*.db
